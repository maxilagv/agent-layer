{
  "bind": "0.0.0.0:9474",
  "ca": "/etc/layeragent-remote/ca.pem",
  "certificate": "/etc/layeragent-remote/coordinator.pem",
  "tls_key": "/etc/layeragent-remote/coordinator.key",
  "database_env": "LAYERAGENT_REMOTE_DATABASE",
  "account": "personal",
