{
  "name": "layeragent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared web/desktop frontend for LayerAgent",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
